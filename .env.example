# Configuration globale SAFINUM Lingua (Dev space ICT)
SAFINUM_TEAM_KEY=sbx_votre_cle
SAFINUM_TEAM_ID=Dev space ICT
SAFINUM_BANK_API_URL=https://www.safinum.cm/api/v1

# Dossier des modèles IA téléchargés
SAFINUM_MODELS_DIR=./models

# Adaptation phonétique des écrans Web/Mobile pour la synthèse vocale fr-FR du sandbox
SAFINUM_UI_PHONETIC_TTS=1

# Modèles IA locaux actifs par défaut
SAFINUM_ENABLE_NMT_NLU=1
ENABLE_LOCAL_NMT=1
ENABLE_AI_CORRECTOR=1

# Optionnel : repli cloud Anthropic (données sensibles toujours masquées)
ANTHROPIC_API_KEY=
