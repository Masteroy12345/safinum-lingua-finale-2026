{
  "manifest_version": 3,
  "name": "Safinum Lingua",
  "version": "1.0.0",
  "description": "Voix camerounaises pour SAFINUM (dua, ewo, bas, bbj, byv, fub, hau, bum, wes). TTS via Vercel/ElevenLabs. Cache, préchauffe, sécurité renforcée.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://safinum-tts-v2.vercel.app/*",
    "https://www.safinum.cm/*",
    "https://safinum.cm/*",
    "https://maryellen-parchable-gertude.ngrok-free.dev/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Safinum Lingua"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.safinum.cm/*",
        "https://safinum.cm/*"
      ],
      "js": [
        "voice_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dictionary.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "audio/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "safinum-lingua@safinum-challenge",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
