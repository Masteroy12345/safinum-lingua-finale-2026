# Clé d'équipe fournie par le sandbox SAFINUM (https://www.safinum.cm/sandbox/docs)
SAFINUM_TEAM_KEY=sbx_votre_cle
SAFINUM_TEAM_ID=Dev space ICT
SAFINUM_BANK_API_URL=https://www.safinum.cm/api/v1

# Port du serveur middleware
PORT=3000

# Adapter l'orthographe Web/Mobile pour la synthèse vocale fr-FR du sandbox (1=actif, 0=AGLC brut)
SAFINUM_UI_PHONETIC_TTS=1

# Activer le repli neuronal local CTranslate2 pour NLU sur phrases inédites
SAFINUM_ENABLE_NMT_NLU=1

# Optionnel : clé API Anthropic si repli cloud souhaité (les données financières sont toujours masquées)
ANTHROPIC_API_KEY=
